exports[`generated files per app expo-router + query + zustand + socket.io 1`] = `
"// Generated by agent-bridge init <version>. Yours to edit: init skips this file unless --force.
import { cdpTransport, type Scenarios, useAgentBridge } from '@avasapp/agent-bridge'
import { expoTransport } from '@avasapp/agent-bridge/expo'
import { routerTools } from '@avasapp/agent-bridge/expo-router'
import { queryTools } from '@avasapp/agent-bridge/tanstack-query'
import { QueryClientContext } from '@tanstack/react-query'
import { router, useNavigationContainerRef } from 'expo-router'
import { useContext } from 'react'

// Zustand stores are left out: they often hold tokens. Add \`redact\` for those
// paths, then uncomment these and storeTools below. See
// https://github.com/avas-app/agent-bridge/blob/main/docs/adapters.md
// import { storeTools } from '@avasapp/agent-bridge/zustand'
// import { useAuthStore } from '../stores/auth'
// import { useSettings } from '../stores/settings'

// TODO socket.io: the adapter must wrap the client where it is created,
// before the app subscribes (https://github.com/avas-app/agent-bridge/blob/main/docs/realtime.md).
// In src/lib/socket.ts, right after \`socket\` is created, add:
//   import { socketIoTools } from '@avasapp/agent-bridge/socket.io'
//   export const realtimeDevTools = socketIoTools(socket)
// then import realtimeDevTools here and uncomment it in tools.

const scenarios: Scenarios = {
  // A user signed in locally with every request mocked: the state most flows
  // start from. See https://github.com/avas-app/agent-bridge/blob/main/docs/scenarios.md
  // signedIn: {
  //   description: 'Signed in locally; no request reaches a server.',
  //   apply: async ({ call, onUndo }) => {
  //     onUndo(strictNetwork())  // and mockApi, both from '@avasapp/agent-bridge/network'
  //     onUndo(mockApi(API_URL, { 'GET /me': { json: user } }))
  //     await call('store.set', 'auth', { token: 'local', user })
  //     return { user }
  //   },
  // },
}

export function AgentBridge() {
  // Undefined outside a QueryClientProvider: mount this inside one for query.* tools.
  const queryClient = useContext(QueryClientContext)
  useAgentBridge({
    name: 'Sprout',
    transports: [expoTransport(), cdpTransport()],
    tools: {
      ...(queryClient ? queryTools(queryClient) : {}),
      ...routerTools(router, { navigation: useNavigationContainerRef() }),
      // ...storeTools({ auth: useAuthStore, settings: useSettings }, { redact: { auth: ['token'] } }),
      // ...realtimeDevTools,
      // Your own tools: any function, JSON in and out, e.g. 'cart.clear': () => clearCart(),
    },
    scenarios,
  })
  return null
}
"
`;

