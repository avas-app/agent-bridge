"// Generated by agent-bridge init <version> (#4af81cb97886). Run it with:
//   bunx @avasapp/agent-bridge run flows/smoke.flow.mjs
/** @type {import('@avasapp/agent-bridge/client').FlowModule['default']} */
const smoke = async ({ step, expect }) => {
  await step('snapshot', 'screen.snapshot')
  await step('open home', 'router.navigate', '/')
  // TODO: check text your first screen always shows, for example:
  // await expect.text('Welcome')
}

export default smoke
