exports[`generated files per app the smoke flow navigates home only with expo-router 1`] = `
"// Generated by agent-bridge init <version>. Run it with:
//   bunx agent-bridge run flows/smoke.flow.mjs
/** @type {import('@avasapp/agent-bridge/client').FlowModule['default']} */
const smoke = async ({ step }) => {
  await step('snapshot', 'screen.snapshot')
  await step('open home', 'router.navigate', '/')
  // TODO: wait for text your first screen always shows, for example:
  // await step('home shown', 'screen.waitFor', 'Welcome')
  await step('undo', 'bridge.restore')
}

export default smoke
"
`;
