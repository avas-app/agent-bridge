exports[`generated files per app bare RN + navigation + MMKV in JS 1`] = `
"// Generated by agent-bridge init <version>. Yours to edit: init skips this file unless --force.
import { cdpTransport, useAgentBridge } from '@avasapp/agent-bridge'

// MMKV is left out: it often holds tokens, and mmkv.get returns values as they
// are. Wire only instances without secrets: uncomment these and mmkvTools below.
// See https://github.com/avas-app/agent-bridge/blob/main/docs/adapters.md
// import { mmkvTools } from '@avasapp/agent-bridge/react-native-mmkv'
// import { storage } from '../storage'

/** @type {import('@avasapp/agent-bridge').Scenarios} */
const scenarios = {
  // A user signed in locally with every request mocked: the state most flows
  // start from. See https://github.com/avas-app/agent-bridge/blob/main/docs/scenarios.md
  // signedIn: {
  //   description: 'Signed in locally; no request reaches a server.',
  //   apply: async ({ call, onUndo }) => {
  //     onUndo(strictNetwork())  // and mockApi, both from '@avasapp/agent-bridge/network'
  //     onUndo(mockApi(API_URL, { 'GET /me': { json: user } }))
  //     await call('store.set', 'auth', { token: 'local', user })
  //     return { user }
  //   },
  // },
}

export function AgentBridge() {
  useAgentBridge({
    name: 'BareApp',
    transports: [cdpTransport()],
    tools: {
      // ...mmkvTools({ storage }),
      // React Navigation has no adapter. With your container ref
      // (createNavigationContainerRef from @react-navigation/native), tools like these work:
      // 'nav.navigate': (name, params) => navigationRef.navigate(name, params),
      // 'nav.current': () => navigationRef.getCurrentRoute(),
      // Your own tools: any function, JSON in and out, e.g. 'cart.clear': () => clearCart(),
    },
    scenarios,
  })
  return null
}
"
`;

